# Copy to .env and fill in. NEVER commit .env.
# Neon serverless Postgres connection string
DATABASE_URL=
# Google AI Studio key for Gemini Flash
GEMINI_API_KEY=
# Apify token for the LinkedIn source. Leave EMPTY to disable LinkedIn cleanly:
# the run still completes and the digest reports LinkedIn as not configured.
APIFY_TOKEN=
# Dedicated Gmail account + app password (not a normal password)
SMTP_USER=
SMTP_APP_PASSWORD=
# Default recipient for the Monday digest
DIGEST_RECIPIENT=
# Passcode for the Admin send panel and for saving Settings. Server-checked only.
ADMIN_PASSCODE=
# Shared secret Vercel Cron sends; the cron route refuses requests without it.
CRON_SECRET=
